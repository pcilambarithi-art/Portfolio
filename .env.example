# --- AI Configuration (Provider-Independent: Google Gemini, OpenAI, or Groq) ---
# Options: "gemini" | "openai" | "groq"
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_or_groq_api_key_here
# Optional model overrides (defaults are applied automatically):
# For Gemini: gemini-1.5-flash
# For OpenAI: gpt-4o-mini
# For Groq: llama-3.3-70b-versatile
AI_MODEL=gemini-1.5-flash

# --- Email Contact Form Configuration ---
# Options: "resend" | "smtp" | "console" (falls back to secure console logging if no key provided)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=ilambarithi2006@gmail.com

# --- SMTP Configuration (if EMAIL_PROVIDER=smtp) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# --- GitHub Integration Configuration ---
# GitHub Personal Access Token (Optional: increases rate limit from 60 req/hr to 5000 req/hr)
GITHUB_TOKEN=
GITHUB_USERNAME=pcilambarithi-art

# --- Public Site Configuration ---
